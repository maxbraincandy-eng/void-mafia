<?xml version="1.0" encoding="utf-8"?>
<!-- Allow HTTPS traffic to the Void Mafia production server.
     No cleartext (HTTP) is needed since the server is HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">voidmafia.one</domain>
    </domain-config>
</network-security-config>
