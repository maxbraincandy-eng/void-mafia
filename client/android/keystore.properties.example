# Release signing config for Void Mafia (Android).
#
# 1. Generate an upload keystore ONCE (keep the .jks file + these passwords SAFE
#    and backed up — losing them means you can never update the app on Play):
#
#    keytool -genkey -v -keystore void-mafia-upload.jks \
#      -alias void-mafia -keyalg RSA -keysize 2048 -validity 10000
#
# 2. Copy this file to  android/keystore.properties  and fill in the real values.
# 3. keystore.properties and *.jks are git-ignored — they never get committed.
#
# storeFile may be an absolute path or a path relative to the android/ folder.

storeFile=void-mafia-upload.jks
storePassword=CHANGE_ME
keyAlias=void-mafia
keyPassword=CHANGE_ME
