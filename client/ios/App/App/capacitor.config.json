{
	"appId": "one.voidmafia.app",
	"appName": "Void Mafia",
	"webDir": "dist",
	"server": {
		"url": "https://voidmafia.one",
		"cleartext": false,
		"androidScheme": "https"
	},
	"android": {
		"backgroundColor": "#060314",
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1500,
			"backgroundColor": "#060314",
			"androidSplashResourceName": "splash",
			"showSpinner": false
		}
	},
	"packageClassList": []
}
